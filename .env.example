# Обязательные переменные
BOT_TOKEN=your_telegram_bot_token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# ID канала для публикации дропов (опционально, если нужен только личный трекер)
CHANNEL_ID=-1001234567890

# Опционально: Google Apps Script прокси для парсинга защищенных сайтов
GAS_PROXY_URL=

# Опционально: почта ukr.net (IMAP) для личных промокодов от магазинов
EMAIL_USER=
EMAIL_PASS=
IMAP_HOST=imap.ukr.net
ADMIN_USER_ID=

# Опционально: интервалы проверки (в секундах) и порт healthcheck-сервера
RADAR_STANDARD_INTERVAL=600
RADAR_REDDIT_INTERVAL=900
TRACKER_INTERVAL=10800
PORT=10000
